# ==========================================
# RazorRecover Environment Configuration
# ==========================================

# Mode: "simulator" (default, zero-key local testing) or "razorpay" (live test mode)
MODE=simulator

# Razorpay Test Mode Credentials (Required only when MODE=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=whsec_razorrecover_test_secret_123

# AI Explainer API Keys (Optional - deterministic template fallback is active if absent)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./razorrecover.db

# Merchant Guardrail Configurations
MAX_RETRIES=3
MIN_RETRY_INTERVAL_HOURS=6
MAX_DISCOUNT_PCT=10.0
MAX_MESSAGES_PER_48H=2
QUIET_HOURS_START=22
QUIET_HOURS_END=8
HUMAN_ESCALATION_THRESHOLD_INR=50000.0
